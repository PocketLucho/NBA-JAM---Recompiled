 // DOS/BIOS interface
+// ---------------------------------------------------------------------------
+// Minimal LIM EMS 4.0 driver (added for running Midway LOAD2.EXE)
+// Page frame at D000h, 4 x 16KB physical pages, mapping implemented by copy.
+// ---------------------------------------------------------------------------
+#define EMS_FRAME_SEG 0xD000
+#define EMS_PAGES 2048
+static uint8_t *ems_pool;
+static int ems_handle_pages[256];
+static int ems_handle_base[256];
+static int ems_next_base;
+static int ems_phys_map[4] = {-1, -1, -1, -1}; // logical (global) page in each slot
+
+static void ems_writeback(int slot)
+{
+    if(ems_phys_map[slot] >= 0)
+        memcpy(ems_pool + ems_phys_map[slot] * 16384, memory + EMS_FRAME_SEG * 16 + slot * 16384, 16384);
+}
+
+static int ems_map(int slot, int handle, int logical)
+{
+    if(slot < 0 || slot > 3)
+        return 0x8B;
+    ems_writeback(slot);
+    if(logical == 0xFFFF)
+    {
+        ems_phys_map[slot] = -1;
+        return 0;
+    }
+    if(handle < 1 || handle > 255 || logical >= ems_handle_pages[handle])
+        return 0x8A;
+    int g = ems_handle_base[handle] + logical;
+    ems_phys_map[slot] = g;
+    memcpy(memory + EMS_FRAME_SEG * 16 + slot * 16384, ems_pool + g * 16384, 16384);
+    return 0;
+}
+
+static void intr67(void)
+{
+    unsigned ax = cpuGetAX();
+    unsigned ah = ax >> 8, al = ax & 0xFF;
+    int st = 0;
+    if(!ems_pool)
+        ems_pool = calloc(EMS_PAGES, 16384);
+    switch(ah)
+    {
+    case 0x40: break;
+    case 0x41: cpuSetBX(EMS_FRAME_SEG); break;
+    case 0x42: cpuSetBX(EMS_PAGES - ems_next_base); cpuSetDX(EMS_PAGES); break;
+    case 0x43:
+    {
+        unsigned n = cpuGetBX();
+        int h;
+        for(h = 1; h < 256 && ems_handle_pages[h]; h++)
+            ;
+        if(h >= 256) { st = 0x85; break; }
+        if(ems_next_base + (int)n > EMS_PAGES) { st = 0x87; break; }
+        ems_handle_pages[h] = n ? n : 1;
+        ems_handle_base[h] = ems_next_base;
+        ems_next_base += n ? n : 1;
+        cpuSetDX(h);
+        break;
+    }
+    case 0x44: st = ems_map(al, cpuGetDX(), cpuGetBX()); break;
+    case 0x45: if(cpuGetDX() < 256) ems_handle_pages[cpuGetDX()] = 0; break;
+    case 0x46: cpuSetAX(0x0040); return;
+    case 0x47: case 0x48: break;
+    case 0x4B:
+    {
+        int c = 0;
+        for(int h = 1; h < 256; h++) if(ems_handle_pages[h]) c++;
+        cpuSetBX(c);
+        break;
+    }
+    case 0x4C: cpuSetBX(cpuGetDX() < 256 ? ems_handle_pages[cpuGetDX()] : 0); break;
+    case 0x50:
+    {
+        unsigned cnt = cpuGetCX();
+        unsigned addr = cpuGetAddrDS(cpuGetSI());
+        for(unsigned i = 0; i < cnt && !st; i++)
+        {
+            unsigned lp = memory[addr + i * 4] | (memory[addr + i * 4 + 1] << 8);
+            unsigned pp = memory[addr + i * 4 + 2] | (memory[addr + i * 4 + 3] << 8);
+            if(al == 1)
+                pp = (pp - EMS_FRAME_SEG) / 0x400;
+            st = ems_map(pp, cpuGetDX(), lp);
+        }
+        break;
+    }
+    case 0x51:
+    {
+        unsigned h = cpuGetDX(), n = cpuGetBX();
+        if(h < 256 && ems_handle_base[h] + ems_handle_pages[h] == ems_next_base)
+        {
+            ems_next_base = ems_handle_base[h] + n;
+            ems_handle_pages[h] = n;
+        }
+        else if(h < 256 && (int)n <= ems_handle_pages[h])
+            ems_handle_pages[h] = n;
+        else
+            st = 0x87;
+        break;
+    }
+    default:
+        debug(debug_int, "EMS function %02x not supported\n", ah);
+        st = 0x84;
+    }
+    cpuSetAX((st << 8) | (ah == 0x46 ? 0x40 : al));
+}
